// سند كفالة: a guarantee for a government employee (source.pdf page 2). Fields and rules: bond-guarantee-employee.json.
// The dates, the notary's own blanks («حضر لدي أنا …», «الكاتب العدل في محكمة …»), the seal and the signatures are
// completed at the notary.
#import "/lib/form.typ": *
#show: form.with("سند كفالة")

في يوم #dots(2.2cm) الواقع #dots(2.2cm) من شهر#dots(2.2cm) سنة #dots(2.2cm) هجرية، الموافق لليوم#dots(2.2cm) من شهر#dots(2.2cm) لسنة #dots(2.2cm) ميلادية.

#v(0.6em)
حضر لدي أنا#dots(4cm) الكاتب العدل في محكمة #dots(3cm) السيد #fill("guarantor_name", width: 7.5cm) وطلب إلي أن أنظم عليه سنداً يتضمن ما هو آت :

#v(0.6em)
أنه يكفل السيد #fill("employee_name", width: 7.5cm) الذي عين موظفاً في #fill("department", width: 8cm) لدى حكومة المملكة الاردنية الهاشمية

#pad(right: 0.6cm)[
  #chosen("guarantee_kind", "كفالة عدلية مطلقة") كفالة عدلية مطلقة \
  #chosen("guarantee_kind", "كفالة عدلية لقاء مبلغ") كفالة عدلية لقاء مبلغ #fill("guarantee_amount", width: 4cm)
]
بحيث يضمن بلا تعلل وبدون أن تحتاج الحكومة إلى الاستحصال على حكم عليه من المحكمة كل ما يدخله مكفوله المذكور بالغاً ما بلغ في ذمته من الأموال والأشياء والنقود التي تأمنه الحكومة عليها أو تكلّفه بإدارتها أو بالإشراف عليها أو تجعل له علاقة بها بأي من الصور وفيما إذا ساعد غيره على إدخالها أو أي شئ منها إلى ذمته وفيما إذا وجب تضمينه أو استرداد شئ منها منه وفقاً للقوانين والأنظمة أو القرارات والتعليمات أو البلاغات المتبعة سواء كان هذا الاسترداد أو التضمين يستلزم الجزاء أو لا يستلزمه وثبت ذلك بإقراره أو محاسبته أو بالقيود الرسمية أو بأية صورة أخرى ويكفله كذلك بالمبالغ التي تنفقها الحكومة إذا حدث أن اتخذت بشأنه أية إجراءات إما بقضية أو بتحقيق في أعماله أو لأجل الحصول على الأشياء والنقود والأموال التي استودعتها أو إذا ساعد على فقدانها بأي وجه ويقبل القيود الرسمية دون تعلل فيما يختص بتعيين مقدري النفقات المذكورة وذلك علاوة على المبالغ التي يكون مكفوله قد أدخلها في ذمته أو ساعد غيره على إدخالها في ذمة غيره أو ضياعها .

#v(0.6em)
فعليه عقدت مجلساً للعدل ونظمت هذا السند وتلي عليه في المجلس علناً وتفهم مآله حرفياً فأقر بمضمونه ووافق على صحته ووقعه (أو أثبته ببصمته أو خاتمه) بحضوري وعليه صار تسجيله والتوقيع عليه بعد أن ثبت لدي ملاءة الكفيل، ولهذا فإني أصادق على ملاءته حسب الأصول .

#v(1.5em)
#grid(
  columns: (1fr, 1fr),
  column-gutter: 2cm,
  row-gutter: 0.8em,
  align(center)[الكفيل], align(center)[خاتم وتوقيع الكاتب العدل],
  dots(100%), dots(100%),
)
